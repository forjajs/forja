{
  "name": "@forjajs/cli",
  "version": "0.0.0",
  "description": "Forja scaffolding CLI — forja new / forja add / forja make:engine.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "forja": "./bin/run.js"
  },
  "files": [
    "bin",
    "dist",
    "templates"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "oclif": {
    "bin": "forja",
    "dirname": "forja",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "make": {
        "description": "Generate a new engine (feature) in an existing Forja project."
      },
      "orm": {
        "description": "Scaffold and manage @forjajs/orm models, migrations and seeds."
      }
    }
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "@oclif/core": "^4",
    "@oclif/plugin-help": "^6",
    "@forjajs/addon-auth": "*",
    "@forjajs/addon-validator": "*",
    "@forjajs/orm": "*",
    "@forjajs/addon-realtime": "*",
    "@forjajs/addon-i18n": "*",
    "prompts": "^2"
  },
  "devDependencies": {
    "@types/node": "*",
    "@types/prompts": "^2",
    "vitest": "^2"
  },
  "engines": {
    "node": ">=18"
  }
}
