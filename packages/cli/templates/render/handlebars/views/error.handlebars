<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{{appName}} · Error</title>
    <style>
      :root { font-family: "Outfit", system-ui, sans-serif; }
      body {
        margin: 0;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 1rem;
        background-color: #1a1a1e;
        color: #f0eeff;
        text-align: center;
      }
      h1 {
        background-image: linear-gradient(135deg, #ffb3e6 0%, #b796ff 45%, #8a7cff 100%);
        -webkit-background-clip: text;
        background-clip: text;
        -webkit-text-fill-color: transparent;
        font-size: 5rem;
        margin: 0;
      }
      p { color: rgba(240, 238, 255, 0.6); margin: 0; }
      a { color: #b796ff; }
    </style>
  </head>
  <body>
    <h1>{{status}}</h1>
    <p>{{message}}</p>
    <a href="/">Back home</a>
  </body>
</html>
